datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("customer") // 'owner' | 'customer'
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stores       Store[]
  orders       Order[]
  carts        Cart[]
}

model Store {
  id                      String    @id @default(cuid())
  ownerId                 String
  owner                   User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  storeName               String
  address                 String
  taxRate                 Float     @default(5.0) // Percentage (e.g. 5% GST)
  upiVpa                  String    // e.g. storeowner@upi
  subscriptionPlan        String    @default("starter") // 'starter' | 'pro' | 'enterprise'
  subscriptionStatus      String    @default("active")  // 'active' | 'expired' | 'pending'
  subscriptionRenewalDate DateTime?
  lowStockThreshold       Int       @default(5)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  products                Product[]
  orders                  Order[]
  subscriptions           Subscription[]
  carts                   Cart[]
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  sku         String
  barcode     String?
  stockQty    Int      @default(0)
  category    String   @default("General")
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  qrCodeUrl   String?  // Cloudinary URL or high-res base64 data URI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, sku])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     String   @default("[]") // JSON stringified CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, storeId])
}

model Order {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invoiceNumber  String   @unique // INV-{storeId}-{YYYYMMDD}-{sequence}
  items          String   // JSON stringified OrderItem[]
  subtotal       Float
  taxAmount      Float
  discount       Float    @default(0.0)
  total          Float
  paymentStatus  String   @default("pending") // 'pending' | 'paid' | 'failed' | 'refunded'
  transactionRef String?  // Razorpay payment_id
  upiVpa         String?  // Store's UPI ID at transaction time
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Subscription {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan          String   @default("starter")
  amount        Float
  status        String   @default("active") // 'active' | 'expired' | 'pending'
  startDate     DateTime @default(now())
  renewalDate   DateTime
  paymentMethod String   @default("Razorpay UPI")
  autoRenew     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
