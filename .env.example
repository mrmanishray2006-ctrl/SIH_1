DATABASE_URL="file:./dev.db"
# For PostgreSQL production:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/qrshop?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="qrshop_super_secret_session_jwt_key_2026_production"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Credentials (Use Test Mode keys or built-in test simulation)
RAZORPAY_KEY_ID="rzp_test_mock_key_12345"
RAZORPAY_KEY_SECRET="mock_secret_key_67890"

# Cloudinary Credentials (Optional: falls back to high-res base64 storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email Notifications (Resend / SMTP)
RESEND_API_KEY=""
